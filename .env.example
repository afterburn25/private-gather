APP_NAME="Private Gather"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://privategather.com
APP_TIMEZONE=America/Chicago
APP_INSTALLED=false
PRIVATE_GATHER_DOMAIN=privategather.com
PRIVATE_GATHER_URL=https://privategather.com
PRIVATE_GATHER_EDITION=hosted
PRIVATE_GATHER_SHOWCASE_CONTENT=false
SELF_HOSTED_TENANT_ID=
SELF_HOSTED_VISIBILITY=private
SELF_HOSTED_REGISTRATION=approval

PLATFORM_ROOT_DOMAIN=privategather.com
PLATFORM_DOMAIN_TARGET=domains.privategather.com
PLATFORM_WILDCARD_ENABLED=true
PLATFORM_WILDCARD_TARGET=privategather.com
PLATFORM_TENANT_SCHEME=https
PLATFORM_TENANT_MOUNT_PATH=
PLATFORM_RESERVED_SUBDOMAINS=www,admin,api,mail,support,help,billing,account,login,signup,status,cdn,assets,static,domains,install
PLATFORM_TERMS_VERSION=1.0
PLATFORM_PRIVACY_VERSION=1.0
PLATFORM_MARKETPLACE_FEE_BPS=1000

LOG_CHANNEL=stack
LOG_LEVEL=warning
OBSERVABILITY_DSN=
OBSERVABILITY_ENVIRONMENT=production

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=
DB_DATABASE=private_gather
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
CDN_URL=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@privategather.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional registrar adapter. Leave blank until a supported provider bridge is connected.
DOMAIN_REGISTRAR_NAME=manual
DOMAIN_REGISTRAR_ENDPOINT=
DOMAIN_REGISTRAR_TOKEN=

# Optional Web Push. Permission is requested only after a member explicitly enables push.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:noreply@privategather.com

UPGRADE_PRODUCT=privategather/private-gather
UPGRADE_MAX_UPLOAD_MB=256
UPGRADE_MAX_FILES=10000
UPGRADE_MAX_MANIFEST_KB=1024
UPGRADE_MAX_FILE_MB=64
UPGRADE_MAX_EXPANDED_MB=1024
UPGRADE_MAX_ARCHIVE_ENTRIES=20250
UPGRADE_KEEP_BACKUPS=5
UPGRADE_REQUIRE_SIGNATURE=false
UPGRADE_ED25519_PUBLIC_KEY=
